 "html": "{% for row in doc.items %}\r\n<div style=\"width:100%; border:2px solid #000; font-family: Arial, Helvetica, sans-serif; margin-bottom:20px; page-break-after:always;\">\r\n\r\n  <!-- Header -->\r\n  <div style=\"background:#000; color:#fff; text-align:center; padding:8px 0; font-size:26px; font-weight:bold;\">\r\n    Scented Slogan\r\n  </div>\r\n\r\n  <!-- Product Name -->\r\n  <div style=\"text-align:center; font-size:34px; font-weight:bold; padding:14px 0; border-top:2px solid #000; border-bottom:2px solid #000;\">\r\n    {{ row.item_name }}\r\n  </div>\r\n\r\n  <!-- Info Table -->\r\n  <table style=\"width:100%; border-collapse:collapse; font-size:16px;\">\r\n    <tr>\r\n      <td style=\"width:50%; border-right:2px solid #000; border-bottom:2px solid #000; padding:10px; text-align:center;\">\r\n        {{ row.item_code }}\r\n      </td>\r\n      <td style=\"width:50%; border-bottom:2px solid #000; padding:10px; text-align:center;\">\r\n        {{ doc.transaction_date or doc.schedule_date }}\r\n      </td>\r\n    </tr>\r\n\r\n    <tr>\r\n      <td style=\"border-right:2px solid #000; border-bottom:2px solid #000; padding:10px;\">\r\n        Assigned to: {{ row.warehouse }}\r\n      </td>\r\n      <td style=\"border-bottom:2px solid #000; padding:10px;\">\r\n        QTY: {{ row.qty }} {{ row.uom }}\r\n      </td>\r\n    </tr>\r\n\r\n    <tr>\r\n      <td style=\"border-right:2px solid #000; border-bottom:2px solid #000; padding:10px;\">\r\n        Client ID: {{ doc.customer or \"\" }}\r\n      </td>\r\n      <td style=\"border-bottom:2px solid #000; padding:10px;\">\r\n        Bottle Returnable: {{ row.is_return or \"N\" }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Batch Number -->\r\n  <div style=\"text-align:center; font-size:18px; padding:12px 0;\">\r\nBatch No.: {{ doc.schedule_date[8:10] + doc.schedule_date[5:7] + doc.schedule_date[0:4] if doc.schedule_date }}\r\n  </div>\r\n\r\n</div>\r\n{% endfor %}\r\n",
 "margin_top": 15.0,
 "margin_bottom": 15.0,
 "margin_left": 15.0,
