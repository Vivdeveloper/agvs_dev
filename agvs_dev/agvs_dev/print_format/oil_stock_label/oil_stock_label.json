 "html": "<style>\n@page {\n    size: 3in 2in;\n    margin: 0;\n}\n\nhtml, body {\n    width: 3in;\n    height: 2in;\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.print-format {\n    width: 3in;\n    height: 2in;\n}\n\n.label-container {\n    width: 3in;\n    height: 2in;\n    border: 1px solid black;\n    box-sizing: border-box;\n    font-family: Arial, Helvetica, sans-serif;\n}\n\ntable {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n}\n\ntd {\n    width: 50%;\n    border: 1px solid black;\n    padding: 0px;\n    font-size: 8px;\n    line-height: 10px;\n    height: 16px;\n}\n\n\n.title {\n    font-size: 11px;\n    font-weight: bold;\n}\n\n.batch {\n    font-size: 10px;\n    font-weight: bold;\n}\n\n.logo img {\n    max-height: 25px;\n    width: 100%;\n    object-fit: contain;\n}\n</style>\n\n\n<div class=\"\">\n\n    <table class=\"label-container\">\n\n        <!-- Logo -->\n        <tr>\n            <td colspan=\"2\" class=\"logo\" style=\"width:100%; background:black; text-align:center; padding:6px;\">\n                <img src=\"https://scentedslogan.m.frappe.cloud/files/ScentedSlogan2.png\">\n            </td>\n        </tr>\n\n        <!-- Item Name -->\n        <tr>\n            <td colspan=\"2\" class=\"title\" style=\"text-align: center;\">\n                {{ doc.item_name }}\n            </td>\n        </tr>\n\n        <!-- SO and FG -->\n        <tr>\n            <td style=\"text-align: center;\">\n                SO-{{ doc.name }}\n            </td>\n            <td style=\"text-align: left;\">\n                &nbsp;&nbsp;FG :\n            </td>\n        </tr>\n\n        <!-- Number Rows -->\n        <tr>\n            <td style=\"text-align: left;\">1.</td>\n            <td style=\"text-align: left;\">5.</td>\n        </tr>\n        <tr>\n            <td style=\"text-align: left;\">2.</td>\n            <td style=\"text-align: left;\">6.</td>\n        </tr>\n        <tr>\n            <td style=\"text-align: left;\">3.</td>\n            <td style=\"text-align: left;\">7.</td>\n            \n        </tr>\n        <tr>\n            <td style=\"text-align: left;\">4.</td>\n            <td style=\"text-align: left;\">8.</td>\n        </tr>\n\n        <!-- Batch -->\n        <tr>\n            <td colspan=\"2\" class=\"batch\" style=\"text-align: center;\">\n                Batch No.: \n            </td>\n        </tr>\n\n    </table>\n\n</div>\n",
