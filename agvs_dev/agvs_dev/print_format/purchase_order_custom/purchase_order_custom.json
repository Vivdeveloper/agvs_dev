 "html": "{{letterhead}}\n<!-- PO Number -->\n<div style=\"margin-top:10px; font-family: Arial, Helvetica, sans-serif; font-size:11px;\">\n    <b>{{ doc.name }}</b>\n</div>\n\n<hr style=\"border:0; border-top:1px solid #ddd; margin-top:8px; margin-bottom:10px;\">\n\n\n<!-- Supplier + Date Section -->\n<table style=\"width:100%; font-family: Arial, Helvetica, sans-serif; font-size:11px;\">\n\n    <tr>\n        <td style=\"color:#666; width:160px;\">Supplier Name:</td>\n        <td style=\"font-weight:bold;\">{{ doc.supplier }}</td>\n\n        <td style=\"color:#666; width:120px;\">Date:</td>\n        <td style=\"font-weight:bold;\">{{ doc.transaction_date }}</td>\n    </tr>\n\n    <tr>\n        <td></td>\n        <td></td>\n\n        <td style=\"color:#666;\">Required By:</td>\n        <td style=\"font-weight:bold;\">{{ doc.schedule_date }}</td>\n    </tr>\n\n</table>\n\n\n<hr style=\"border:0; border-top:1px solid #ddd; margin-top:10px; margin-bottom:10px;\">\n\n\n<!-- Company Billing Address -->\n<table style=\"width:100%; font-family: Arial, Helvetica, sans-serif; font-size:11px;\">\n\n    <tr>\n\n        <td style=\"color:#666; width:160px; vertical-align:top;\">\n            Company Billing Address:\n        </td>\n\n        <td>\n            {{ doc.company_address_display }}\n        </td>\n\n    </tr>\n\n</table>\n\n\n\n<table style=\"width:100%; border-collapse:collapse; font-family: Arial, Helvetica, sans-serif; font-size:11px; margin-top:15px;\">\n\n    <!-- Table Header -->\n    <thead>\n        <tr>\n\n            <th style=\"border:1px solid #d1d8dd; padding:8px; text-align:left; width:5%;\">\n                Sr\n            </th>\n\n            <th style=\"border:1px solid #d1d8dd; padding:8px; text-align:left; width:55%;\">\n                Description\n            </th>\n\n            <th style=\"border:1px solid #d1d8dd; padding:8px; text-align:right; width:15%;\">\n                Quantity\n            </th>\n\n            <th style=\"border:1px solid #d1d8dd; padding:8px; text-align:right; width:12%;\">\n                Rate\n            </th>\n\n            <th style=\"border:1px solid #d1d8dd; padding:8px; text-align:right; width:13%;\">\n                Amount\n            </th>\n\n        </tr>\n    </thead>\n\n\n    <!-- Table Body -->\n    <tbody>\n\n        {% for item in doc.items %}\n\n        <tr>\n\n            <td style=\"border:1px solid #d1d8dd; padding:8px;\">\n                {{ loop.index }}\n            </td>\n\n            <td style=\"border:1px solid #d1d8dd; padding:8px;\">\n                {{ item.item_code }}<br>\n                {{ item.description }}\n            </td>\n\n            <td style=\"border:1px solid #d1d8dd; padding:8px; text-align:right;\">\n                {{ item.qty }} {{ item.uom }}\n            </td>\n\n            <td style=\"border:1px solid #d1d8dd; padding:8px; text-align:right;\">\n                {{ item.rate }}\n            </td>\n\n            <td style=\"border:1px solid #d1d8dd; padding:8px; text-align:right;\">\n                {{ item.amount }}\n            </td>\n\n        </tr>\n\n        {% endfor %}\n\n    </tbody>\n\n</table>\n\n\n<table style=\"width:100%; font-family: Arial, Helvetica, sans-serif; font-size:11px; margin-top:10px; border-top:1px solid #d1d8dd;\">\n\n    <tr>\n\n        <!-- LEFT SIDE -->\n        <td style=\"width:55%; padding-top:10px; vertical-align:top;\">\n\n            <table style=\"width:100%;\">\n\n                <tr>\n                    <td style=\"color:#555;\">Total Quantity:</td>\n                    <td style=\"text-align:right;\">\n                        {{ doc.total_qty }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"padding-top:10px; color:#555;\">In Words:</td>\n                    <td style=\"padding-top:10px;\">\n                        {{ doc.in_words }}\n                    </td>\n                </tr>\n\n            </table>\n\n        </td>\n\n\n        <!-- RIGHT SIDE TOTALS -->\n        <td style=\"width:45%; padding-top:10px; vertical-align:top;\">\n\n            <table style=\"width:100%;\">\n\n                <tr>\n                    <td style=\"color:#555;\">Net Total:</td>\n                    <td style=\"text-align:right;\">\n                        {{ doc.net_total }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"padding-top:6px; color:#555;\">Grand Total:</td>\n                    <td style=\"text-align:right; padding-top:6px;\">\n                        {{ doc.grand_total }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"padding-top:6px; color:#555;\">Rounded Total:</td>\n                    <td style=\"text-align:right; padding-top:6px;\">\n                        {{ doc.rounded_total }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"padding-top:6px; color:#555;\">Additional Discount Amount:</td>\n                    <td style=\"text-align:right; padding-top:6px;\">\n                        {{ doc.discount_amount }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"padding-top:6px; color:#555;\">Advance Paid:</td>\n                    <td style=\"text-align:right; padding-top:6px;\">\n                        {{ doc.advance_paid }}\n                    </td>\n                </tr>\n\n            </table>\n\n        </td>\n\n    </tr>\n\n</table>\n\n\n<table style=\"width:100%; font-family: Arial, Helvetica, sans-serif; font-size:11px; margin-top:60px;\">\n\n    <tr>\n\n        <td style=\"width:60%;\"></td>\n\n        <td style=\"width:40%; text-align:right;\">\n\n            <div style=\"font-weight:bold; margin-bottom:40px;\">\n                {{ doc.company }}\n            </div>\n\n            <div style=\"border-top:1px solid #000; width:200px; float:right;\"></div>\n\n            <div style=\"clear:both; padding-top:5px; font-weight:bold;\">\n                Authorized<br>\n                Signatory\n            </div>\n\n        </td>\n\n    </tr>\n\n</table>\n\n\n",
