 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\">\\t\\t\\t\\t<h2><div>Delivery Note</div><br><small class=\\\"sub-heading\\\">{{ _(doc.name) }}</small>\\t\\t\\t\\t</h2></div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<style>\\n    .print-container {\\n        width: 6in;\\n        height: 4in;\\n    }\\n</style>\\n\\n<div class=\\\"print-container\\\">\\n\\n    <div style=\\\"display:flex; width:100%;\\\">\\n        <!-- First TD with Image -->\\n        <div style=\\\"background:#000; text-align:center; padding:10px; border:1px solid #000; width:80%;\\\">\\n            <img src=\\\"https://scentedslogan.m.frappe.cloud/files/ScentedSlogan4.png\\\" style=\\\"width:100%; height:50px; display:block;\\\">\\n        </div>\\n\\n        <!-- Second TD Black Box -->\\n        <div style=\\\"background:#000; border:1px solid #000; width:20%;\\\">\\n            <img src=\\\"https://scentedslogan.m.frappe.cloud/files/qr.png\\\" style=\\\"width:50%; height:40px; display:block; margin-right:20px; margin-top:15px;\\\">\\n        </div>\\n    </div>\\n\\n    <div style=\\\"display:flex; width:100%;\\\">\\n        <div class=\\\"left block\\\" style=\\\"width:75%;\\\">\\n            <table style=\\\"width:100%; height:186px; border-collapse:collapse; font-family:Arial, sans-serif; font-size:14px;\\\">\\n\\n    <!-- Product ID Row -->\\n                <tr>\\n                    <td style=\\\"border:1px solid #000;\\\">\\n                        <strong style=\\\"font-size:11px; padding: -4px !important; \\\">Product ID(s):</strong>\\n                    </td>\\n                    <td style=\\\"border:1px solid #000; border-right:none; font-size:14px;\\\">\\n                        <span style=\\\"font-size:11px;  padding:1px;\\\">\\n                            {% for item in doc.items %}\\n                                {{ item.item_code }}  \\n                            {% endfor %}\\n                        </span>\\n                    </td>\\n                    <td style=\\\"border:1px solid #000; border-left:none; border-right:none;padding:2px; font-size:20px;\\\">\\n                    </td>\\n                    <td style=\\\"border:1px solid #000; border-left:none; padding:2px; font-size:20px;\\\">\\n                    </td>\\n                </tr>\\n\\n    <!-- TO Row -->\\n                <tr>\\n                    <td colspan=\\\"1\\\" style=\\\"border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">To</strong>\\n                    </td>\\n                    <td style=\\\"border:1px solid #000; border-right:none; padding:2px;\\\">\\n                        <span style=\\\"font-size:11px\\\">{{doc.customer_name}}</span>\\n                    </td>\\n                    <td style=\\\"border:1px solid #000; border-right:none; border-left:none; padding:2px; font-size:20px;\\\">\\n                    </td>\\n                    <td style=\\\"border:1px solid #000; border-left:none; padding:2px; font-size:20px;\\\">\\n                    </td>\\n                </tr>\\n\\n    <!-- Address Section -->\\n                <tr>\\n        <!-- Left Block -->\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; vertical-align:top; padding:2px; height:50px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">To: <br>{{doc.customer_address}}</strong><br>\\n                        <span style=\\\"font-size:11px;\\\">\\n                            {{doc.address_display}}\\n                        </span>\\n                    </td>\\n    \\n        <!-- Right Block -->\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; vertical-align:top; padding:2px; height:50px\\\">\\n                        <strong style=\\\"font-size:11px\\\">From: <br>{{doc.company_address}}</strong><br>\\n                        <span style=\\\"font-size:11px;\\\">\\n                            {{doc.company_address_display}}\\n                        </span>\\n                    </td>\\n                </tr>\\n\\n    <!-- Bottom Info Rows -->\\n                <tr>\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">Contact No.:</strong> <span style=\\\"font-size:11px\\\">{{doc.contact_display}}</span>\\n                    </td>\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">Contact No.:</strong> <span style=\\\"font-size:11px\\\"> +91 9892101595</span><br>\\n                    </td>\\n                </tr>\\n    \\n                <tr>\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">Alt Contact:</strong> <span style=\\\"font-size:11px\\\">{{doc.contact_mobile}}</span>\\n                    </td>\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">Telephone No.:</strong> <span style=\\\"font-size:11px\\\"> 022 4568 9973</span><br>\\n                    </td>\\n                </tr>\\n        \\n                <tr>\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">Client ID:</strong> <span style=\\\"font-size:11px\\\">{{doc.customer}}</span>\\n                    </td>\\n                    <td colspan=\\\"2\\\" style=\\\"width:50%; border:1px solid #000; padding:2px;\\\">\\n                        <strong style=\\\"font-size:11px\\\">Shipping ID:</strong> <span style=\\\"font-size:11px\\\">{{doc.name}}</span><br>\\n                        <strong style=\\\"font-size:11px\\\">Shipping Date:</strong> <span style=\\\"font-size:11px\\\">{{doc.posting_date}}</span>\\n                    </td>\\n                </tr>\\n            </table>\\n        </div>\\n    \\n        <div class=\\\"right block\\\" style=\\\"width:25%;\\\">\\n            <table style=\\\"width:100%; border-collapse:collapse; font-family:Arial, sans-serif; text-align:center;height:100px;\\\">\\n\\n    <!-- First Row Image -->\\n                <tr>\\n                    <td style=\\\"border:1px solid #000; padding:0;\\\">\\n                        <img src=\\\"https://scentedslogan.m.frappe.cloud/files/Fragile1.png\\\" style=\\\"width:100%; height:186px; display:block;\\\">\\n                    </td>\\n                </tr>\\n\\n    <!-- Barcode Instruction -->\\n                <tr>\\n                    <td style=\\\"border:1px solid #000; padding:20px; font-size:18px; font-weight:bold;\\\">\\n                        STICK/APPLY SHIPPING<br>BARCODE\\n                    </td>\\n                </tr>\\n\\n    <!-- Bottom Note -->\\n                <tr>\\n                    <td style=\\\"border:1px solid #000; padding:12px; font-size:15px; font-weight:bold;\\\">\\n                        Not for resale. If lost return to AGVS Enterprises Pvt. Ltd.\\n                    </td>\\n                </tr>\\n            </table>\\n        </div>\\n    </div>\\n\\n</div>\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\"}]",
